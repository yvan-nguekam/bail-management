# ---------------------------------------------------------------------------
# Base de données PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL : connexion utilisée par l'application (Prisma Client).
# DIRECT_URL   : connexion directe utilisée par les migrations (`pnpm db:migrate`,
#                `pnpm db:deploy`) et Prisma Studio.
#
# En local (Postgres.app, Docker...), les deux URLs sont identiques.
# Sur Supabase, DATABASE_URL pointe vers le pooler (port 6543, `?pgbouncer=true`)
# et DIRECT_URL vers la base directe (port 5432). Voir README > "Base de données".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bail_management"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bail_management"

# Exemple Supabase (Dashboard > Project Settings > Database > Connection string) :
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""

# Emails (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Bail Management <noreply@example.com>"

# Tâches planifiées (statuts des baux et paiements)
# Secret envoyé par le planificateur : Authorization: Bearer <CRON_SECRET>
# Générer avec : openssl rand -base64 32
CRON_SECRET=""
